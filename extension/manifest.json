{
  "manifest_version": 3,
  "name": "Sidebar Nav",
  "version": "0.5.0",
  "description": "Open a left-edge navigation sidebar on sites you choose. Scan for feature links and save them on this device.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sidebar Nav",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/sidebar-16.png",
      "32": "icons/sidebar-32.png",
      "48": "icons/sidebar-48.png",
      "128": "icons/sidebar-128.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/sidebar-16.png",
    "32": "icons/sidebar-32.png",
    "48": "icons/sidebar-48.png",
    "128": "icons/sidebar-128.png"
  }
}
